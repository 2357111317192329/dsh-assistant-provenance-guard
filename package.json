{
  "name": "dsh-assistant-provenance-guard",
  "version": "0.1.1",
  "description": "Fail-closed DSH guard that rejects assistant responses impersonating system, developer, user, or goal messages before tools execute.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2357111317192329/dsh-assistant-provenance-guard"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "prompt-injection",
    "provenance",
    "security"
  ],
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "npm test && npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
